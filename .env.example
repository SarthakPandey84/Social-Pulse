# SocialPulse Local Environment Template (NEVER commit real secrets)
# Copy this file to `.env` locally when authenticating optional external APIs.

# Meta / Instagram Graph API (OAuth user/business account authorization required)
META_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0

# YouTube Data API v3 (public statistics/metadata key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Kaggle API (for datasets hosted only on Kaggle, e.g. youtube-trending-video-dataset)
KAGGLE_USERNAME=
KAGGLE_KEY=
# Or use KAGGLE_API_TOKEN=
KAGGLE_API_TOKEN=

# Secret key for HMAC-SHA256 handle/account pseudonymization (`src/preprocessing/quality_pipeline.py`).
# SECURITY WARNING: Do NOT rely on the legacy public salt fallback for sensitive real-world identifiers;
# set a strong random `SOCIALPULSE_PII_HMAC_KEY` here (or pass `allow_legacy_public_salt=False`).
# Legacy compatibility SHA-256 mode only exists for reproducing checked-in public benchmark fixtures.
SOCIALPULSE_PII_HMAC_KEY=

